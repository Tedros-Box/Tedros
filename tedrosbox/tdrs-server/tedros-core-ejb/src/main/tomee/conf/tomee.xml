<?xml version="1.0" encoding="UTF-8"?>
<tomee>
  <!-- see http://tomee.apache.org/containers-and-resources.html -->

  <!-- activate next line to be able to deploy applications in apps -->
  <!-- <Deployments dir="apps" /> -->
  
<!-- Datasource parametrizado via system properties tedros.db.*
     (mesmo contrato do server-application / Docker TEDROS_DB_*).
     Default do produto: PostgreSQL. Para outro vendor, defina:
       -Dtedros.db.driver=...
       -Dtedros.db.url=...
       -Dtedros.db.user=...
       -Dtedros.db.password=...
     Ou use os profiles Maven db-<vendor> no Cargo. -->
<Resource id="tedrosDataSource" type="DataSource">
  JdbcDriver ${tedros.db.driver}
  JdbcUrl ${tedros.db.url}
  UserName ${tedros.db.user}
  Password ${tedros.db.password}
  JtaManaged true
  PoolPreparedStatements true
  DefaultAutoCommit true
</Resource>

  
</tomee>
